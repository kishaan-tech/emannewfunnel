# Copy to .env.local for local `vercel dev`, and set the same names in your
# host's project settings (Vercel: Settings -> Environment Variables, marked
# Sensitive). NEVER put real values in this file: it is committed.
#
# Generate a secret:
#   node -e 'console.log("whsec_"+require("crypto").randomBytes(32).toString("base64"))'

# Shared with your dashboard. Both sides must hold the same value.
FUNNEL_SIGNING_SECRET=

# Set ONLY while rotating the secret. See README section 3a.
FUNNEL_SIGNING_SECRET_PREV=

# Required destination. A failure here makes the relay return 502 so the
# browser keeps the lead queued and retries.
DASHBOARD_URL=

# Best-effort destination. A failure here is logged and ignored.
# Comma separate to fan out to more than one catch hook.
#
# REGISTRATIONS ONLY. The relay skips these entirely when the submission
# carries optin_type=replay, so replay opt-ins never reach the webinar Zaps.
ZAPIER_HOOK_URL=

# Survey submissions only (optin_type=survey / event=survey, from
# brand-operator-survey.html). Routing the survey through the relay rather than
# posting to this hook from the page is what gets client_ip_address onto the
# row: a browser cannot read its own public IP.
ZAPIER_SURVEY_HOOK_URL=

# Replay opt-ins only (optin_type=replay, set by the form on /replay-optin).
# Same rules: best effort, comma separate for more than one hook.
# Leave this EMPTY and replay leads still reach the dashboard, just no Zap.
ZAPIER_REPLAY_HOOK_URL=

# Only needed when the relay is on a DIFFERENT domain to the site.
# Comma separated, no trailing slash. e.g. https://funnel.example.com
ALLOWED_ORIGINS=
